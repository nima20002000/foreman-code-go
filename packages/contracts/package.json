{
  "name": "@graphql/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./operator-chat": {
      "types": "./dist/operatorChat.d.ts",
      "import": "./dist/operatorChat.js"
    },
    "./wave25": {
      "types": "./dist/wave25/index.d.ts",
      "import": "./dist/wave25/index.js"
    },
    "./management": {
      "types": "./dist/management/index.d.ts",
      "import": "./dist/management/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
