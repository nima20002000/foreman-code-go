{
  "name": "graphql",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.15.4"
  },
  "scripts": {
    "dev": "pnpm --filter @graphql/contracts build && pnpm --parallel --filter @graphql/contracts --filter @graphql/web dev",
    "dev:api": "pnpm --filter @graphql/contracts build && pnpm --parallel --filter @graphql/contracts --filter @graphql/api dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "typecheck": "pnpm --filter @graphql/contracts build && pnpm -r --if-present typecheck",
    "lint": "pnpm --filter @graphql/contracts build && pnpm -r --if-present lint",
    "test": "pnpm --filter @graphql/contracts build && pnpm -r --if-present test",
    "test:integration": "pnpm --filter @graphql/contracts build && pnpm --filter @graphql/api test:integration",
    "test:production": "node scripts/production-smoke.mjs",
    "build": "pnpm -r --if-present build"
  }
}
