{
  "name": "@graphql/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --exclude '**/*.integration.test.ts' --exclude test/real-harness.acceptance.test.ts",
    "test:integration": "vitest run .integration.test.ts --no-file-parallelism",
    "test:acceptance": "RUN_REAL_HARNESS_TESTS=1 vitest run test/real-harness.acceptance.test.ts",
    "credential": "node --import tsx src/cli/operatorCredentials.ts",
    "harness:check": "node --import tsx src/cli/harnessCompatibility.ts",
    "build": "tsc -p tsconfig.build.json && node dist/cli/harnessCompatibility.js"
  },
  "dependencies": {
    "@graphql/contracts": "workspace:*",
    "@langchain/core": "1.2.11",
    "@langchain/langgraph": "1.4.15",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@modelcontextprotocol/fastify": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@openai/codex": "0.154.0",
    "better-auth": "1.7.5",
    "fastify": "5.12.4",
    "hono": "4.11.4",
    "pg": "8.23.0",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.5.1",
    "@types/pg": "8.20.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
