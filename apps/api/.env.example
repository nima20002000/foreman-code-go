HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://graphql:graphql@127.0.0.1:5432/graphql
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=1000
READINESS_TIMEOUT_MS=2000
LANGGRAPH_CHECKPOINT_SCHEMA=langgraph
HARNESS_WORKSPACE_ROOT=/tmp/graphql-harness-runs
HARNESS_TIMEOUT_MS=300000
# `codex` resolves to this app's pinned @openai/codex installation, not the global CLI.
CODEX_BINARY=codex
# OpenCode is external: keep the server's installed CLI at the qualified 1.18.31 version.
OPENCODE_BINARY=opencode

# Browser sign-in: generate one random secret (at least 32 characters).
# Keep BETTER_AUTH_SECRET stable across restarts. No insecure development fallback.
# BETTER_AUTH_SECRET=<persistent-random-secret>
# BETTER_AUTH_URL=http://127.0.0.1:5173
# Existing installations MUST explicitly link an active root Operator principal:
# OWNER_OPERATOR_PRINCIPAL_ID=principal-...
